# Copy to .env.local and fill in. .env.local is git-ignored.

# Anthropic key — held server-side only (used by /api/evaluate and /api/test). Never prefixed
# NEXT_PUBLIC_, so it is never sent to the browser. Get one at https://console.anthropic.com
ANTHROPIC_API_KEY=

# Groq key — server-side only, powers mic dictation (/api/transcribe) via Whisper. Optional:
# unset, the mic button still renders but every dictation returns an error. Groq's free tier
# needs no credit card and covers 2,000 requests / 8 hours of audio a day, which is far more
# than this app uses. Get one at https://console.groq.com/keys
GROQ_API_KEY=

# Comma-separated allowlist of emails permitted to use the paid API routes. REQUIRED: the routes
# fail closed, so an unset value rejects every caller. Match the address you sign in with.
# A signed-in user whose email isn't listed is sent to /no-access instead of into the app.
# e.g. ALLOWED_EMAILS=you@example.com,teammate@example.com
ALLOWED_EMAILS=

# Optional. If set, the /no-access screen shows a "Request access" button that opens a prefilled
# email to this address. Leave unset to omit the button. Server-side only (no NEXT_PUBLIC_).
# e.g. ACCESS_CONTACT_EMAIL=owner@example.com
ACCESS_CONTACT_EMAIL=

# Supabase project — the anon key is public by design; Row-Level Security isolates each user's
# rows. Both are read in the browser, hence the NEXT_PUBLIC_ prefix.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
